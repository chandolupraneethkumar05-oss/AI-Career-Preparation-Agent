# ==============================================================================
# Environment Configuration Template for AI Career Preparation Agent
# Copy this file to .env and configure values before starting the application.
# Never commit real API keys, passwords, or production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & SECURITY
# ------------------------------------------------------------------------------

# Application environment: development or production
ENVIRONMENT=development

# Generate a unique secret before production deployment.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty for the development-only fallback.
SECRET_KEY=

# Backend HTTP port
PORT=8000

# Comma-separated list of permitted frontend origins.
# Replace localhost origins with your actual production frontend origin.
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. DATABASE & RECORDING STORAGE
# ------------------------------------------------------------------------------

# Docker Compose paths; these are overridden by Compose as configured.
# For local development, use a suitable local SQLite path.
DATABASE_URL=sqlite:////app/data/career_agent.db
RECORDINGS_STORAGE_DIR=/app/storage/recordings

# ------------------------------------------------------------------------------
# 3. AI / LLM PROVIDERS
# ------------------------------------------------------------------------------

# Supported providers: groq, gemini, openai
# Leave blank to allow automatic provider selection and local fallback.
LLM_PROVIDER=

# Groq configuration
# Get an API key from https://console.groq.com/
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini configuration
# Get an API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
DEBUG_GEMINI=false

# OpenAI configuration
# Get an API key from https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google API key alias, if required by your configuration
GOOGLE_API_KEY=

# Embedding provider: local or openai
EMBEDDING_PROVIDER=local

# ------------------------------------------------------------------------------
# 4. EMAIL & PRACTICE REMINDERS
# ------------------------------------------------------------------------------

# Modes: development, smtp, resend
EMAIL_MODE=development

# Resend configuration
# Get an API key from https://resend.com/
RESEND_API_KEY=

# SMTP configuration (required for live SMTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@career-agent.dev

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------

# Vite frontend API base URL
# For Docker/Nginx same-origin proxying, keep /api if supported by the frontend.
VITE_API_URL=/api