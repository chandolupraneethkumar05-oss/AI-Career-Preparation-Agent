# Database Connection (Defaults to local SQLite database)
DATABASE_URL=sqlite:///career_agent.db

# LLM & AI Provider Keys (Optional: agent uses robust local deterministic fallbacks if unset)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Application URL (for CORS and reminder link resolution)
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
