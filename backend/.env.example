# ==============================================================================
# Environment Configuration for AI Career Preparation Agent
# ==============================================================================

# Application Environment & Security
ENVIRONMENT=development
SECRET_KEY=generate_with_python_secrets_token_hex_32
PORT=8000
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173

# Database & Storage
DATABASE_URL=sqlite:///./career_agent.db
RECORDINGS_STORAGE_DIR=./storage/recordings

# ------------------------------------------------------------------------------
# 1. PASSWORD RESET SECURITY AUTHORIZATION KEY
# ------------------------------------------------------------------------------
# Required when a candidate recovers or resets their password on the login screen
PASSWORD_RESET_API_KEY=CAREER_AGENT_RESET_SECRET_2026

# ------------------------------------------------------------------------------
# 2. EMAIL DELIVERY (Resend REST API)
# ------------------------------------------------------------------------------
EMAIL_MODE=resend
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 3. GLOBAL MULTI-CLOUD AI PROVIDERS & CASCADING RESILIENCE
# If any dedicated mode key runs out of quota or fails, the engine automatically
# cascades through these global cloud providers before falling back to local.
# ------------------------------------------------------------------------------
# OpenAI (Industry leader for in-depth answer feedback & deep ATS resume scoring)
OPENAI_API_KEY=sk-proj-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Primary for daily challenges, curriculum RAG grounding, and quick answers)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# NVIDIA NIM (Llama-3.3-70b-instruct for hiring committee calibration and technical evaluation)
NVIDIA_API_KEY=

# Groq Cloud (Ultra-low latency question generation via LPU inference engine)
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 4. DEDICATED PER-MODE INTERVIEW AI KEYS (Zero Key Reuse)
# Accepts any key type (OpenAI sk-*, Gemini AIzaSy*, Grok xai-*, Groq gsk_*, NVIDIA nvapi-*, HuggingFace hf_*)
# ------------------------------------------------------------------------------
# Mode 1: Written Text & Sandbox Mode (Recommended: Grok / Groq / OpenAI)
INTERVIEW_TEXT_API_KEY=

# Mode 2: Video AI Mock Mode (Recommended: Google Gemini Studio Key #1)
INTERVIEW_VIDEO_API_KEY=

# Mode 3: Face-to-Face AI Mode (Recommended: Google Gemini Studio Key #2)
INTERVIEW_FACE_TO_FACE_API_KEY=

# Mode 4: Peer Collaborative Chamber Mode (Recommended: Hugging Face or NVIDIA NIM)
INTERVIEW_PEER_CHAMBER_API_KEY=

# Mode 5: Reverse Mock Mode (Simulated candidate roleplay) (Recommended: Grok / OpenAI)
INTERVIEW_REVERSE_MOCK_API_KEY=

# Mode 6: Technology-Focused / Resume-Grounded Mock Mode (Dedicated Key for Java, Python, C++, SQL)
INTERVIEW_TECH_FOCUS_API_KEY=

# ------------------------------------------------------------------------------
# 5. FEATURE-SPECIFIC AI KEYS (Zero Key Reuse)
# ------------------------------------------------------------------------------
# Feature 1: Skill Gap Competency Radar & Action Plan (Recommended: Gemini Studio Key #3 or OpenAI)
SKILL_GAP_API_KEY=

# Feature 2: 3-Minute JIT Skill Primers & Verification Quizzes (Zero Quota Collision)
SKILL_PRIMER_API_KEY=

# Feature 3: Resume Parsing & ATS Match Score (Recommended: OpenAI or NVIDIA NIM or Hirelayer)
RESUME_ATS_API_KEY=

# ------------------------------------------------------------------------------
# 6. LOCAL EMBEDDINGS & FRONTEND URL
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
VITE_API_URL=/api
