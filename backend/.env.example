# AI Career Preparation Agent — Backend Environment Configuration

# SQLite Database Connection URL
DATABASE_URL=sqlite:///./career_agent.db

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Proactive Reminder Email Settings (Optional SMTP)
# If omitted, email dispatcher operates in simulated development mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@career-agent.dev


# Password Reset Security API Key (Required for candidate password recovery)
PASSWORD_RESET_API_KEY=

# ------------------------------------------------------------------------------
# 7. PER-MODE INTERVIEW AI API KEYS (Dedicated Key for Each Mode)
# Accepts any key type (Groq gsk_*, Gemini AIzaSy*, OpenAI sk-*, NVIDIA nvapi-*)
# ------------------------------------------------------------------------------
# Written Text & Sandbox Interview Mode
INTERVIEW_TEXT_API_KEY=

# Video AI Mock Interview Mode
INTERVIEW_VIDEO_API_KEY=

# Face-to-Face AI Interview Mode
INTERVIEW_FACE_TO_FACE_API_KEY=

# Peer Collaborative Chamber Mode (Live challenges, hints, 360 double-sided reviews)
INTERVIEW_PEER_CHAMBER_API_KEY=

# Reverse Mock Interview Mode (Simulated candidate AI actor & interviewer coaching)
INTERVIEW_REVERSE_MOCK_API_KEY=

# ------------------------------------------------------------------------------
# 8. FEATURE-SPECIFIC AI API KEYS
# ------------------------------------------------------------------------------
# Dedicated API Key for Skill Gap Competency Radar & Actionable Remediation
SKILL_GAP_API_KEY=

# Dedicated API Key for Resume Parsing, Deep ATS Scoring & Keyword Gap Analysis
RESUME_ATS_API_KEY=
